<?xml version="1.0" encoding="utf-8"?>
<!-- Type scale. Each style points at one weight file so weights render the
     same on every Android version (textStyle="bold" would fake them). -->
<resources>

    <style name="TextAppearance.LabaLink.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="lineHeight">36sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.LabaLink.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="lineHeight">28sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.LabaLink.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">24sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.LabaLink.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.LabaLink.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">22sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.LabaLink.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">19sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
    </style>

    <style name="TextAppearance.LabaLink.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.LabaLink.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textColor">@color/ink_tertiary</item>
    </style>

    <style name="TextAppearance.LabaLink.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink_tertiary</item>
    </style>

    <!-- Money: tabular figures so digits don't jump while counting up. -->
    <style name="TextAppearance.LabaLink.Amount" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_extrabold</item>
        <item name="android:textSize">34sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.LabaLink.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.LabaLink.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.LabaLink.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
