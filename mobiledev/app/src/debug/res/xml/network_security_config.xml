<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: allows http:// so the app can reach a backend on
     your laptop (10.0.2.2 from the emulator, or your LAN IP from a phone).
     Release builds use src/main/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
