<?xml version="1.0" encoding="utf-8"?>
<!-- Circle draws in, then the tick: about 550ms in total. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="24dp" android:height="24dp"
            android:viewportWidth="24" android:viewportHeight="24">
            <path android:name="ring"
                android:pathData="M12,2A10,10 0 1 1 11.99,2"
                android:strokeColor="@color/white" android:strokeWidth="2"
                android:strokeLineCap="round" android:trimPathEnd="0" />
            <path android:name="tick"
                android:pathData="M8,12.5L10.8,15.2L16,9.5"
                android:strokeColor="@color/white" android:strokeWidth="2.2"
                android:strokeLineCap="round" android:strokeLineJoin="round"
                android:trimPathEnd="0" />
        </vector>
    </aapt:attr>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd"
                android:valueFrom="0" android:valueTo="1" android:duration="350"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="tick">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd"
                android:valueFrom="0" android:valueTo="1" android:duration="200"
                android:startOffset="300"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
