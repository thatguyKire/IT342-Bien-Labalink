<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        style="@style/Widget.LabaLink.TopBar"
        android:paddingStart="16dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:src="@drawable/logo_mark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="LabaLink"
            android:textAppearance="@style/TextAppearance.LabaLink.Title" />

        <!-- Wallet pill: opens the Wallet tab -->
        <LinearLayout
            android:id="@+id/walletPill"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/brand_tint"
            android:clickable="true"
            android:contentDescription="Wallet balance"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@animator/press_scale">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wallet"
                app:tint="@color/brand" />

            <TextView
                android:id="@+id/tvWalletBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFeatureSettings="tnum"
                android:text="₱ 0.00"
                android:textAppearance="@style/TextAppearance.LabaLink.Label"
                android:textColor="@color/brand" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero -->
            <FrameLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_card"
                android:clipChildren="true"
                android:outlineProvider="background"
                android:padding="20dp">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="-36dp"
                    android:layout_marginBottom="-52dp"
                    android:alpha="0.14"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_droplets"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi there"
                        android:textAppearance="@style/TextAppearance.LabaLink.Label"
                        android:textColor="@color/white_70" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Ready to wash\n&amp; dry?"
                        android:textAppearance="@style/TextAppearance.LabaLink.Display"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="48dp"
                        android:text="Pick a free machine, scan its sticker, and you're running."
                        android:textAppearance="@style/TextAppearance.LabaLink.BodySmall"
                        android:textColor="@color/white_70" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAvailableCount"
                            style="@style/Widget.LabaLink.Badge"
                            android:backgroundTint="@color/white_16"
                            android:drawableStart="@drawable/ic_circle_check_16"
                            android:drawablePadding="6dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="– available"
                            android:textColor="@color/white"
                            app:drawableTint="@color/white" />

                        <TextView
                            android:id="@+id/tvRunningCount"
                            style="@style/Widget.LabaLink.Badge"
                            android:layout_marginStart="8dp"
                            android:backgroundTint="@color/white_16"
                            android:drawableStart="@drawable/ic_timer_16"
                            android:drawablePadding="6dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="– running"
                            android:textColor="@color/white"
                            app:drawableTint="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Section header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Machines"
                    android:textAppearance="@style/TextAppearance.LabaLink.Title" />

                <!-- Live indicator: the halo pulses behind the dot -->
                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp">

                    <View
                        android:id="@+id/liveHalo"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_live_dot" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_live_dot" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="Live"
                    android:textAppearance="@style/TextAppearance.LabaLink.Label"
                    android:textColor="@color/accent_deep" />

                <TextView
                    android:id="@+id/tvMachineCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 total"
                    android:textAppearance="@style/TextAppearance.LabaLink.Caption" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMachines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:layoutAnimation="@anim/layout_rise"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <ImageView
                    style="@style/Widget.LabaLink.IconTile"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:padding="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_washing_machine" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No machines yet"
                    android:textAppearance="@style/TextAppearance.LabaLink.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Check back soon."
                    android:textAppearance="@style/TextAppearance.LabaLink.BodySmall" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
