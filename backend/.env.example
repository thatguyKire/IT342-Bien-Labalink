# Copy to backend/.env and fill in. NEVER commit the real .env file.
# Optional settings are commented out. Remove the "# " to set one. A line
# left as "KEY=" (blank) overrides the built-in default with an empty
# value, so keep unused settings commented out.

# --- Database (PostgreSQL 14+) ---
DB_URL=jdbc:postgresql://localhost:5432/labalink
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT --- (required, >= 32 bytes) generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Google OAuth (optional; https://console.cloud.google.com/apis/credentials) ---
# Web client used by the attendant dashboard (redirect URI:
#   http://localhost:8080/login/oauth2/code/google)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Client IDs accepted for Google ID tokens sent by the Android app
# (usually the same Web client ID). Comma-separated.
# GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com

# --- Stripe (optional; test mode keys: https://dashboard.stripe.com/test/apikeys) ---
# Live keys (sk_live_...) are refused at startup: this is a class project.
# STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:8080/api/payments/webhook`
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Mail (optional; Gmail: use an App Password, not your real password) ---
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=
# MAIL_FROM=you@gmail.com

# --- First attendant account (created once if no attendant exists) ---
BOOTSTRAP_ATTENDANT_EMAIL=
BOOTSTRAP_ATTENDANT_PASSWORD=
BOOTSTRAP_ATTENDANT_USERNAME=Admin

# --- Production ---
# SESSION_COOKIE_SECURE=true
# FORWARD_HEADERS_STRATEGY=native
