<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topAppBar"
        style="@style/Widget.LabaLink.TopBar">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.LabaLink.IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Machine"
            android:textAppearance="@style/TextAppearance.LabaLink.Title" />

        <Space
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hero -->
            <FrameLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_gradient_card"
                android:outlineProvider="background">

                <ImageView
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="-40dp"
                    android:layout_marginBottom="-56dp"
                    android:alpha="0.14"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_droplets"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivMachineIcon"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_icon_tile"
                        android:backgroundTint="@color/white_16"
                        android:importantForAccessibility="no"
                        android:padding="20dp"
                        android:src="@drawable/ic_washing_machine"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvImageLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Washing machine"
                        android:textAppearance="@style/TextAppearance.LabaLink.Label"
                        android:textColor="@color/white_70" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMachineName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Washer 1"
                        android:textAppearance="@style/TextAppearance.LabaLink.Headline" />

                    <TextView
                        android:id="@+id/tvHourlyRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="₱ 60.00 / hr"
                        android:textAppearance="@style/TextAppearance.LabaLink.Title"
                        android:textColor="@color/brand" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMachineType"
                        style="@style/Widget.LabaLink.Badge"
                        android:text="Washer" />

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/Widget.LabaLink.Badge"
                        android:layout_marginStart="8dp"
                        android:text="Available" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:text="How it works"
                    android:textAppearance="@style/TextAppearance.LabaLink.Title" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Step 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Widget.LabaLink.IconTile"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="9dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_scan_qr_code" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Scan the sticker"
                                    android:textAppearance="@style/TextAppearance.LabaLink.TitleSmall" />

                                <TextView
                                    android:id="@+id/tvQrToken"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Point the camera at the QR code on this machine."
                                    android:textAppearance="@style/TextAppearance.LabaLink.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="54dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/divider" />

                        <!-- Step 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Widget.LabaLink.IconTile"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="9dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_wallet" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pay from your wallet"
                                    android:textAppearance="@style/TextAppearance.LabaLink.TitleSmall" />

                                <TextView
                                    android:id="@+id/tvPriceNote"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="₱ 60.00 for 60 minutes."
                                    android:textAppearance="@style/TextAppearance.LabaLink.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="54dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/divider" />

                        <!-- Step 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Widget.LabaLink.IconTile"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="9dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sparkles" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="The attendant starts it"
                                    android:textAppearance="@style/TextAppearance.LabaLink.TitleSmall" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Follow it live under Bookings."
                                    android:textAppearance="@style/TextAppearance.LabaLink.BodySmall" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomActionArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartNewWash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan &amp; start"
            app:icon="@drawable/ic_scan_line" />

        <TextView
            android:id="@+id/tvActionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Make sure you're standing at the machine."
            android:textAppearance="@style/TextAppearance.LabaLink.Caption" />
    </LinearLayout>
</LinearLayout>
