<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        style="@style/Widget.LabaLink.TopBar"
        android:paddingStart="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wallet"
            android:textAppearance="@style/TextAppearance.LabaLink.Headline" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Balance -->
            <FrameLayout
                android:id="@+id/balanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_card"
                android:outlineProvider="background"
                android:padding="20dp">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="-36dp"
                    android:layout_marginBottom="-56dp"
                    android:alpha="0.14"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_droplets"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/white_70" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Balance"
                            android:textAppearance="@style/TextAppearance.LabaLink.Overline"
                            android:textColor="@color/white_70" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="₱ 0.00"
                        android:textAppearance="@style/TextAppearance.LabaLink.Amount" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pay for every wash in one scan."
                        android:textAppearance="@style/TextAppearance.LabaLink.BodySmall"
                        android:textColor="@color/white_70" />
                </LinearLayout>
            </FrameLayout>

            <!-- Add funds -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/addFundsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add funds"
                        android:textAppearance="@style/TextAppearance.LabaLink.Title" />

                    <TextView
                        android:id="@+id/tvError"
                        style="@style/Widget.LabaLink.Banner.Error"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:id="@+id/tvSuccess"
                        style="@style/Widget.LabaLink.Banner.Success"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Amount"
                        android:textAppearance="@style/TextAppearance.LabaLink.Overline" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/amountChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/btn50"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱50" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/btn100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="₱100" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/btn200"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱200" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/btn500"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₱500" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Or enter an amount"
                        app:helperText="₱50 to ₱10,000"
                        app:prefixText="₱ ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCustomAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_rounded_12"
                        android:backgroundTint="@color/surface_muted"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/brand" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="You'll pay on Stripe's secure page. Card details never pass through LabaLink."
                            android:textAppearance="@style/TextAppearance.LabaLink.BodySmall" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTopUp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Pay securely with Stripe"
                        app:icon="@drawable/ic_lock" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Stripe test mode. No real money is charged."
                        android:textAppearance="@style/TextAppearance.LabaLink.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- History -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent activity"
                        android:textAppearance="@style/TextAppearance.LabaLink.Title" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTransactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layoutAnimation="@anim/layout_rise"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <TextView
                        android:id="@+id/tvNoTransactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="No top-ups yet"
                        android:textAppearance="@style/TextAppearance.LabaLink.BodySmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logout: revokes the token on the server and wipes it here -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.LabaLink.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Log out"
                app:icon="@drawable/ic_log_out" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
