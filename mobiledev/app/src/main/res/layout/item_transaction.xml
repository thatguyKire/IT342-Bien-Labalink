<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/ivIcon"
        style="@style/Widget.LabaLink.IconTile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_arrow_down_left" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:text="₱ 100.00"
            android:textAppearance="@style/TextAppearance.LabaLink.TitleSmall" />

        <TextView
            android:id="@+id/tvReference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="LL-1-DEMO"
            android:textAppearance="@style/TextAppearance.LabaLink.Caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatus"
            style="@style/Widget.LabaLink.Badge"
            android:text="Paid" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nov 3, 2026"
            android:textAppearance="@style/TextAppearance.LabaLink.Caption" />
    </LinearLayout>
</LinearLayout>
